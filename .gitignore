# ==============================================================================
# CampusOS Root .gitignore (Comprehensive Monorepo Protection)
# ==============================================================================

# Python & Backend Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# Databases & SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db-journal

# Node.js & Package Managers
node_modules/
**/node_modules/
.npm/
.yarn/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite & Frontend Builds
apps/web/dist/
**/dist/
dist-ssr/
apps/web/.vite/
**/.vite/

# Testing & Audits
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
lh.json
lighthouse-report.json
playwright-results.json
*.json.log

# Operating Systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Text Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Secrets & Environment Files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Docker & Logs
*.log
docker-compose.override.yml
